# Environment Configuration Template
# Copy this file to .env and fill in your values

# Endee Vector Database Configuration
# =====================
# Endee runs on port 8080 via Docker
ENDEE_BASE_URL=http://localhost:8080
ENDEE_AUTH_TOKEN=  # Optional: leave empty for no authentication
ENDEE_INDEX_NAME=research_copilot
ENDEE_DIMENSION=384  # Default embedding dimension for sentence-transformers

# LLM Configuration
# =====================
# Choose your LLM provider: openai, anthropic
LLM_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=2000

# Anthropic Configuration (alternative)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-opus-20240229
ANTHROPIC_TEMPERATURE=0.7
ANTHROPIC_MAX_TOKENS=2000

# Embedding Model Configuration
# =====================
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu  # Options: cpu, cuda
EMBEDDING_BATCH_SIZE=32

# Document Processing Configuration
# =====================
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_FILE_SIZE_MB=50

# GitHub Configuration (optional)
# =====================
GITHUB_TOKEN=your_github_token_here

# RAG Pipeline Configuration
# =====================
TOP_K_DOCUMENTS=5
RAG_MAX_CONTEXT_LENGTH=4000

# Server Configuration
# =====================
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Logging Configuration
# =====================
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
